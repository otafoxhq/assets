{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:otafox:design-tokens:1.1.0",
  "title": "Otafox design token contract",
  "description": "Local schema for portable Otafox token sources. It intentionally uses value, type, and description rather than claiming DTCG conformance.",
  "type": "object",
  "required": ["$schema", "version", "status", "updated", "source", "tokens"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./schema.json" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "updated": { "type": "string", "format": "date" },
    "source": { "const": "../DESIGN.md" },
    "mode": { "enum": ["light", "dark"] },
    "tokens": { "$ref": "#/$defs/group" }
  },
  "$defs": {
    "token": {
      "type": "object",
      "required": ["value", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "number" }
            }
          ]
        },
        "type": {
          "enum": ["color", "dimension", "number", "fontFamily", "fontWeight", "duration", "cubicBezier"]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "group": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/token" },
          { "$ref": "#/$defs/group" }
        ]
      }
    }
  }
}
